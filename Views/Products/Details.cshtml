@model ShopApp.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-md-5">
        <img src="@(Model.ImageUrl ?? "/images/placeholder.jpg")" class="img-fluid rounded shadow" alt="@Model.Name" />
    </div>
    <div class="col-md-7">
        <span class="badge bg-secondary mb-2">@Model.Category?.Name</span>
        <h2>@Model.Name</h2>
        <h3 class="text-success">KES @Model.Price.ToString("N2")</h3>
        <p class="text-muted">@Model.Description</p>

        @if (Model.Stock > 0)
        {
            <p class="text-success"><i class="bi bi-check-circle-fill me-1"></i>In Stock (@Model.Stock available)</p>
            <form asp-controller="Products" asp-action="AddToCart" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="d-flex align-items-center gap-3 mb-3">
                    <label class="fw-bold">Quantity:</label>
                    <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" style="width:80px;" />
                </div>
                <button type="submit" class="btn btn-warning btn-lg">
                    <i class="bi bi-cart-plus me-1"></i>Add to Cart
                </button>
            </form>
        }
        else
        {
            <p class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>Out of Stock</p>
        }
    </div>
</div>

<!-- Related Products -->
@if (ViewBag.RelatedProducts is List<ShopApp.Models.Product> related && related.Any())
{
    <hr class="my-5" />
    <h4>Related Products</h4>
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var p in related)
        {
            <div class="col">
                <div class="card h-100 shadow-sm hover-card">
                    <img src="@(p.ImageUrl ?? "/images/placeholder.jpg")" class="card-img-top"
                         alt="@p.Name" style="height:150px;object-fit:cover;" />
                    <div class="card-body p-2">
                        <h6 class="card-title small">@p.Name</h6>
                        <p class="text-success mb-1 small fw-bold">KES @p.Price.ToString("N2")</p>
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark w-100">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
