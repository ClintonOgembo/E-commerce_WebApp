@model IEnumerable<ShopApp.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="row">
    <!-- Sidebar filters -->
    <div class="col-md-3">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white fw-bold">Filters</div>
            <div class="card-body">
                <h6>Category</h6>
                <ul class="list-unstyled">
                    <li>
                        <a asp-action="Index" class="text-decoration-none @(ViewBag.CurrentCategory == null ? "fw-bold" : "")">All</a>
                    </li>
                    @foreach (var cat in (List<ShopApp.Models.Category>)ViewBag.Categories)
                    {
                        <li>
                            <a asp-action="Index" asp-route-categoryId="@cat.Id"
                               class="text-decoration-none @(ViewBag.CurrentCategory == cat.Id ? "fw-bold text-primary" : "")">
                                @cat.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Product grid -->
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>@(ViewBag.Search != null ? $"Results for \"{ViewBag.Search}\"" : "All Products")</h4>
            <form method="get">
                @if (ViewBag.CurrentCategory != null)
                {
                    <input type="hidden" name="categoryId" value="@ViewBag.CurrentCategory" />
                }
                <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Sort: Name</option>
                    <option value="price_asc"  selected="@(ViewBag.Sort=="price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(ViewBag.Sort=="price_desc")">Price: High to Low</option>
                    <option value="newest"     selected="@(ViewBag.Sort=="newest")">Newest</option>
                </select>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">No products found.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var product in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm hover-card">
                            <img src="@(product.ImageUrl ?? "/images/placeholder.jpg")"
                                 class="card-img-top" alt="@product.Name" style="height:180px;object-fit:cover;" />
                            <div class="card-body">
                                <h6 class="card-title">@product.Name</h6>
                                <p class="card-text text-muted small">@(product.Description.Length > 60 ? product.Description[..60] + "…" : product.Description)</p>
                            </div>
                            <div class="card-footer d-flex justify-content-between align-items-center">
                                <strong class="text-success">KES @product.Price.ToString("N2")</strong>
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-dark">Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
