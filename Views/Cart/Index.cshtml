@model List<ShopApp.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
}

<h2 class="mb-4"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h2>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-cart-x display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">Your cart is empty</h4>
        <a asp-controller="Products" asp-action="Index" class="btn btn-warning mt-3">Start Shopping</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(item.ImageUrl ?? "/images/placeholder.jpg")"
                                                 width="50" height="50" style="object-fit:cover;" class="rounded" />
                                            <span>@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td>KES @item.UnitPrice.ToString("N2")</td>
                                    <td style="width:120px;">
                                        <form asp-action="Update" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" style="width:65px;" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-repeat"></i></button>
                                        </form>
                                    </td>
                                    <td class="fw-bold text-success">KES @item.Total.ToString("N2")</td>
                                    <td>
                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">Order Summary</div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <strong>KES @ViewBag.Total.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Shipping</span>
                        <span class="text-success">Free</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                        <span>Total</span>
                        <span class="text-success">KES @ViewBag.Total.ToString("N2")</span>
                    </div>
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-warning w-100 btn-lg">
                        <i class="bi bi-lock-fill me-1"></i>Proceed to Checkout
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
}
