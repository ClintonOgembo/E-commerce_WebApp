@model IEnumerable<ShopApp.Models.Product>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<div class="p-5 mb-4 bg-dark text-white rounded-3">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold"><i class="bi bi-bag-heart-fill text-danger me-2"></i>Welcome to ShopApp</h1>
        <p class="col-md-8 fs-4">Discover quality products at great prices. Fast delivery, easy returns.</p>
        <a class="btn btn-warning btn-lg" asp-controller="Products" asp-action="Index">
            Shop Now <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</div>

<!-- Categories -->
<h3 class="mb-3">Browse by Category</h3>
<div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
    @foreach (var cat in (List<ShopApp.Models.Category>)ViewBag.Categories)
    {
        <div class="col">
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@cat.Id"
               class="card h-100 text-center text-decoration-none border-0 shadow-sm hover-card">
                <div class="card-body py-4">
                    <i class="bi bi-grid fs-2 text-primary mb-2"></i>
                    <h6 class="card-title mb-0">@cat.Name</h6>
                </div>
            </a>
        </div>
    }
</div>

<!-- Featured Products -->
<h3 class="mb-3">Featured Products</h3>
<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm hover-card">
                <img src="@(product.ImageUrl ?? "/images/placeholder.jpg")"
                     class="card-img-top" alt="@product.Name" style="height:200px;object-fit:cover;" />
                <div class="card-body">
                    <span class="badge bg-secondary mb-1">@product.Category?.Name</span>
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text text-muted small">@(product.Description.Length > 80 ? product.Description[..80] + "…" : product.Description)</p>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <strong class="text-success fs-5">KES @product.Price.ToString("N2")</strong>
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                       class="btn btn-sm btn-dark">View Details</a>
                </div>
            </div>
        </div>
    }
</div>
