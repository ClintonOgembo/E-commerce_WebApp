@model IEnumerable<ShopApp.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<h2 class="mb-4"><i class="bi bi-bag-check me-2"></i>My Orders</h2>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-bag-x display-1"></i>
        <h4 class="mt-3">No orders yet</h4>
        <a asp-controller="Products" asp-action="Index" class="btn btn-warning mt-2">Start Shopping</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>@order.Items.Count item(s)</td>
                        <td class="text-success fw-bold">KES @order.TotalAmount.ToString("N2")</td>
                        <td>
                            @{
                                var badge = order.Status switch {
                                    ShopApp.Models.OrderStatus.Pending => "bg-warning text-dark",
                                    ShopApp.Models.OrderStatus.Processing => "bg-info text-dark",
                                    ShopApp.Models.OrderStatus.Shipped => "bg-primary",
                                    ShopApp.Models.OrderStatus.Delivered => "bg-success",
                                    ShopApp.Models.OrderStatus.Cancelled => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badge">@order.Status</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
