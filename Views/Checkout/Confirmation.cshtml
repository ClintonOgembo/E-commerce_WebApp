@model ShopApp.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="text-center py-4">
    <i class="bi bi-check-circle-fill display-1 text-success"></i>
    <h2 class="mt-3">Order Confirmed!</h2>
    <p class="text-muted">Thank you for your purchase. Your order #@Model.Id has been placed.</p>
</div>

<div class="card shadow-sm mx-auto" style="max-width:600px;">
    <div class="card-header bg-success text-white fw-bold">Order #@Model.Id</div>
    <ul class="list-group list-group-flush">
        @foreach (var item in Model.Items)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@item.Product?.Name <span class="badge bg-secondary">x@item.Quantity</span></span>
                <strong>KES @((item.UnitPrice * item.Quantity).ToString("N2"))</strong>
            </li>
        }
        <li class="list-group-item d-flex justify-content-between fw-bold bg-light">
            <span>Total Paid</span>
            <span class="text-success">KES @Model.TotalAmount.ToString("N2")</span>
        </li>
    </ul>
    <div class="card-footer text-muted small">
        <i class="bi bi-truck me-1"></i>Shipping to: @Model.ShippingAddress, @Model.ShippingCity, @Model.ShippingCountry
    </div>
</div>

<div class="text-center mt-4 d-flex gap-2 justify-content-center">
    <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-bag me-1"></i>My Orders
    </a>
    <a asp-controller="Products" asp-action="Index" class="btn btn-warning">
        Continue Shopping
    </a>
</div>
